# ==============================================================================
# Autonomous GitHub to LinkedIn Spotlight Agent - Environment Configuration
# ==============================================================================

# EURI LLM API Configuration
EURI_API_KEY=your_euri_api_key_here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=gpt-4.1-mini
EURI_MAX_TOKENS=1500
EURI_TEMPERATURE=0.55

# GitHub Configuration (Optional: Increases rate limit)
GITHUB_TOKEN=

# Telegram Human-in-the-Loop (HITL) Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LinkedIn API Configuration
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here

# Application Settings
DATABASE_PATH=data/history.db
MIN_GITHUB_STARS=5000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
